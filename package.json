{
  "name": "nostr-chain-node",
  "version": "0.1.0",
  "private": true,
  "description": "Nostr Blockchain v0 reference prototype",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "nostr-chain-node": "dist/cli/main.js",
    "nostr-chain-wallet": "dist/tools/wallet.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "acceptance": "npm run build && node dist/tests/acceptance/prototype-demo.js"
  },
  "dependencies": {
    "@noble/ciphers": "1.2.0",
    "@noble/curves": "1.6.0",
    "@scure/base": "1.1.9",
    "better-sqlite3": "11.8.1",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "24.3.0",
    "@types/ws": "8.5.12",
    "typescript": "5.9.2"
  }
}
